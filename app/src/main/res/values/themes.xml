<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Mostra o papel de parede real do celular atrás do launcher -->
    <style name="Quadro" parent="android:Theme.Material.Wallpaper.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Quadro.Transparente" parent="android:Theme.Translucent.NoTitleBar" />
</resources>
